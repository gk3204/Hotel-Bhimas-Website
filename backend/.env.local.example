# Copy to .env.local and load it INSTEAD OF .env whenever you run this backend, or any script in
# backend/scripts/, on a development machine.
#
# Why this file exists (F-06). backend/.env holds the hotel's LIVE credentials — WhatsApp, two
# Mailjet accounts, Razorpay, the OTA mailbox. Every script here loads it, so a one-off run on a
# laptop can message or charge real guests. During the 2026-09-24 QA run exactly that happened: a
# direct-database script reached Meta's API, and was refused only because the local .env carries
# Meta's TEST number. Mailjet has no equivalent safety net.
#
#   SAFE_MODE makes that impossible rather than unlikely.

# Refuse every outbound WhatsApp and e-mail, and log what would have been sent.
SAFE_MODE=true

# Your own throwaway database — never the production one.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bhimas_qa
DB_USER=postgres
DB_PASSWORD=

# Belt and braces: with the credentials blank, nothing can authenticate even if SAFE_MODE is missed.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
MAILJET_API_KEY=
MAILJET_API_SECRET=
ENQUIRY_MAILJET_API_KEY=
ENQUIRY_MAILJET_API_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
OTA_IMAP_PASSWORD=

# The schedulers write to whatever database you point at and some of them message people.
WHATSAPP_SCHEDULER_ENABLED=false
OTA_IMAP_SCHEDULER_ENABLED=false
REVIEW_SCHEDULER_ENABLED=false
NIGHT_AUDIT_SCHEDULER_ENABLED=false
OVERSTAY_SCHEDULER_ENABLED=false
