# ============================================================================
# Hotel Bhimas — VPS environment. Copy to `.env` on the server and fill in.
#   cp .env.vps.example .env   &&   nano .env
# Anything left blank falls back to "feature quietly off" (see the go-live runbook §B2).
# NEVER commit the real .env — it holds every secret.
# ============================================================================

# ---- Postgres (used by BOTH the db container and the api via DATABASE_URL) ----
POSTGRES_USER=bhimas
POSTGRES_PASSWORD=CHANGE_ME_long_random_db_password
POSTGRES_DB=hotelbhimas

# The api reads DATABASE_URL directly. Host is the compose service name `db`.
DATABASE_URL=postgresql://bhimas:CHANGE_ME_long_random_db_password@db:5432/hotelbhimas

# ---- Core (MUST be set — the system is wrong without them) ----
SECRET_KEY=CHANGE_ME_min_32_random_chars_new_for_production
TZ=Asia/Kolkata
ENVIRONMENT=production
# The website domains that may call the API from a browser (comma-separated, no spaces).
CORS_ORIGINS=https://hotelbhimas.in,https://www.hotelbhimas.in
# Used in guest-portal / QR / payment-return links — set it to your public site.
PUBLIC_SITE_URL=https://hotelbhimas.in
API_BASE_URL=https://api.hotelbhimas.in
FRONTEND_URL=https://hotelbhimas.in

# Do NOT enable this on day one — a wrong network list locks you out of admin.
RESTRICT_ADMIN_ACCESS=false
ALLOWED_ADMIN_NETWORKS=

# ---- Guest ID scans (KYC) — persisted on the mounted volume (compose maps ./data/id_scans) ----
ID_SCAN_DIR=/app/id_scans
# Generate once:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# LOSE THIS AND EVERY STORED SCAN IS PERMANENTLY UNREADABLE. Keep an offline copy off the VPS.
ID_SCAN_ENCRYPTION_KEY=CHANGE_ME_fernet_key

# ---- Money: Razorpay (LIVE keys in production) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Must match the webhook you create in the Razorpay dashboard, pointed at
# https://api.hotelbhimas.in/payments/webhook — else desk UPI / links never confirm.
RAZORPAY_WEBHOOK_SECRET=

# ---- Email (Mailjet) — booking mail + the owner day/week report attachment ----
MAILJET_API_KEY=
MAILJET_API_SECRET=
MAIL_FROM=noreply@hotelbhimas.in

# ---- WhatsApp (Meta Cloud API) — inbox, alerts, report PDF. Off (stub) until all set. ----
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0

# ---- OTA mailbox (optional — auto-draft OTA bookings) ----
OTA_IMAP_HOST=
OTA_IMAP_PORT=993
OTA_IMAP_USER=
OTA_IMAP_PASSWORD=
OTA_IMAP_SSL=true
OTA_IMAP_FOLDER=INBOX
OTA_IMAP_POLL_INTERVAL_MINUTES=15

# ---- Uploads / CDN (optional; without R2, CRM/menu uploads sit on the mounted disk) ----
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET=
R2_BUCKET=
R2_PUBLIC_URL=
R2_ENDPOINT=

# ---- Google reviews (optional) ----
GBP_CLIENT_ID=
GBP_CLIENT_SECRET=
GBP_REFRESH_TOKEN=
GBP_ACCOUNT_ID=
GBP_LOCATION_ID=
ANTHROPIC_API_KEY=
REVIEW_TEST_INJECT_ENABLED=false

# ---- Schedulers (all default ON; set false only to disable one) ----
# WHATSAPP_SCHEDULER_ENABLED=true
# NIGHT_AUDIT_SCHEDULER_ENABLED=true
# OVERSTAY_SCHEDULER_ENABLED=true
# OTA_IMAP_SCHEDULER_ENABLED=true
# REVIEW_SCHEDULER_ENABLED=true

# ---- Front-desk policy (env fallbacks; the Settings screen overrides these once saved) ----
CHECKOUT_MODE=24h
CARD_GRACE_MINUTES=60

LOG_LEVEL=INFO
