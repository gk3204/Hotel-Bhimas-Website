# Database Configuration
DB_USER=postgres
DB_PASSWORD=your_secure_password_here
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hotelbhimas

# Environment
ENVIRONMENT=development

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Admin Access (set to false in production)
RESTRICT_ADMIN_ACCESS=true
ALLOWED_ADMIN_NETWORKS=192.168.0.0/16,127.0.0.1

# JWT/Authentication
SECRET_KEY=your_very_secure_random_key_min_32_characters_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# REQUIRED for webhook-confirmed payments (website checkout + desk UPI-QR/link, prompt 19).
# Set this to the signing secret configured on the Razorpay webhook (Dashboard > Webhooks).
# Subscribe the webhook to: payment.authorized, payment.failed, payment.captured,
# qr_code.credited, payment_link.paid. Without it POST /payments/webhook returns 500.
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Email Configuration (Mailjet - 200 emails/day free, works on Railway)
MAILJET_API_KEY=your_mailjet_api_key
MAILJET_API_SECRET=your_mailjet_api_secret
MAIL_FROM=noreply@hotelbhimas.com

# API Configuration
API_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# Google Review Auto-Reply (prompt 20) — all optional, feature is off/pluggable by default.
# GBP (Google Business Profile) API: replies are posted for real only when ALL of these are set,
# else the poller returns nothing and post_reply stub-logs (pipeline still testable via inject).
# Requires GBP API access approval (form-based, days of lead time — apply early) + OAuth as the
# profile owner/manager. The refresh token is minted once via the OAuth consent flow.
GBP_CLIENT_ID=
GBP_CLIENT_SECRET=
GBP_REFRESH_TOKEN=
GBP_ACCOUNT_ID=
GBP_LOCATION_ID=
# Optional Claude LLM reply generation. Needs BOTH this key AND the review_llm_enabled app_setting.
# When off, replies come from the built-in rotating template pool.
ANTHROPIC_API_KEY=
# In-process review poller (poll → generate → post). Set to false to disable it.
REVIEW_SCHEDULER_ENABLED=true
# Dev-only "inject test review" admin endpoint. SET TO false IN PRODUCTION.
REVIEW_TEST_INJECT_ENABLED=true

# Logging
LOG_LEVEL=INFO
